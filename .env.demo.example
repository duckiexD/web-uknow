# Demo конфигурация для футбольной секции «Высота»
APP_ENV=demo
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=5000

# База данных (демо-данные)
DATABASE_PATH=/app/backend/demo_database.db

# Безопасность (демо-режим)
SECRET_KEY=demo_secret_key_for_testing_only
CORS_ORIGINS=*

# Режим демонстрации
DEMO_MODE=true
DEMO_USER_NAME=Демо-пользователь